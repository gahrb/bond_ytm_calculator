{
  "manifest_version": 3,
  "name": "Bond YTM & Pricing Calculator",
  "version": "1.5.0",
  "description": "Calculates Yield to Maturity (YTM), Accrued Interest, and Dirty Price using standard ICMA bond formulas.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.openfigi.com/*",
    "https://api.boerse-frankfurt.de/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
